{
	"profiles": {
		"Tgs.BrandCertificateService": {
			"commandName": "Project",
			"launchBrowser": true,
			"launchUrl": "swagger",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Brand-Cert-Api(local)",
				"NODE_IP": "otel.rpgp.cc"
			},
			"dotnetRunMessages": true,
			"applicationUrl": "https://localhost:8898;http://localhost:8899"
		},
		"Docker": {
			"commandName": "Docker",
			"launchBrowser": true,
			"launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
			"publishAllPorts": true,
			"useSSL": true
		}
	}
}
