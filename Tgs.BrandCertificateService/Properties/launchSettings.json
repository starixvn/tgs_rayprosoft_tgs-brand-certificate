{
  "profiles": {
    "Tgs.BrandCertificateService": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "Brand-Cert-Api(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:8900;http://localhost:8899"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "publishAllPorts": true,
      "useSSL": true
    }
  }
}